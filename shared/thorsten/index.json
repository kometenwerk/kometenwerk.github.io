   "dauer": 1.52,
   "hash": "027df5c0540e"
  },
  {
   "id": "los-1",
   "gruppe": "los",
   "text": "Und los!",
   "datei": "ton/los-1.mp3",
   "dauer": 0.76,
   "hash": "1b041bc28686"
  },
  {
   "id": "los-2",
   "gruppe": "los",
   "text": "Drei, zwei, eins, Krawall!",
   "datei": "ton/los-2.mp3",
   "dauer": 2.35,
   "hash": "8c76d57de9cd"
  },
  {
   "id": "los-3",
   "gruppe": "los",
   "text": "Okay, Konzentration. Jetzt geht's los!",
   "datei": "ton/los-3.mp3",
   "dauer": 2.64,
   "hash": "e4fd084b1549"
  },
  {
   "id": "los-4",
   "gruppe": "los",
   "text": "Neue Runde, neues Glück!",
   "datei": "ton/los-4.mp3",
   "dauer": 1.59,
   "hash": "b12d07e09383"
  },
  {
   "id": "treffer-1",
   "gruppe": "ko_treffer",
   "text": "Ja! Erwischt!",
   "datei": "ton/treffer-1.mp3",
   "dauer": 1.2,
   "hash": "503272f0b1de"
  },
  {
   "id": "treffer-2",
   "gruppe": "ko_treffer",
   "text": "Den hab ich umgehauen!",
   "datei": "ton/treffer-2.mp3",
   "dauer": 1.23,
   "hash": "ea674f8575ed"
  },
  {
   "id": "treffer-3",
   "gruppe": "ko_treffer",
   "text": "Boom! Der ist raus!",
   "datei": "ton/treffer-3.mp3",
   "dauer": 1.31,
   "hash": "1cc957426e8a"
  },
  {
   "id": "treffer-4",
   "gruppe": "ko_treffer",
   "text": "Einer weniger, weiter so!",
   "datei": "ton/treffer-4.mp3",
   "dauer": 1.44,
   "hash": "d3d3fcf8c107"
  },
  {
   "id": "treffer-5",
   "gruppe": "ko_treffer",
   "text": "Sauber! Das war mein Moment!",
   "datei": "ton/treffer-5.mp3",
   "dauer": 1.72,
   "hash": "2bcb1c483a3d"
  },
  {
   "id": "treffer-6",
   "gruppe": "ko_treffer",
   "text": "Haha, damit hat er nicht gerechnet!",
   "datei": "ton/treffer-6.mp3",
   "dauer": 1.83,
   "hash": "2a45a0363d8b"
  },
  {
   "id": "raus-1",
   "gruppe": "ko_raus",
   "text": "Nein! Mein Tier ist raus!",
