   "dauer": 1.93,
   "hash": "ada8a896e654"
  },
  {
   "id": "short-2",
   "gruppe": "short_intro",
   "text": "Krawallzoo, eine Runde, volle Action. Los!",
   "datei": "ton/short-2.mp3",
   "dauer": 3.03,
   "hash": "34a4e596099e"
  },
  {
   "id": "short-3",
   "gruppe": "short_intro",
   "text": "Achtung, jetzt wird's wild!",
