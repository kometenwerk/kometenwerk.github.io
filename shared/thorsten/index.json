   "dauer": 2.22,
   "hash": "2a3b82046b1d"
  },
  {
   "id": "item-schild",
   "gruppe": "item_schild",
   "text": "Schild an. Kommt doch her!",
   "datei": "ton/item-schild.mp3",
   "dauer": 1.52,
   "hash": "bdf6619ce3a2"
  },
  {
   "id": "nebel-1",
   "gruppe": "nebel",
   "text": "Der Nebel kommt! Ab in die Mitte!",
