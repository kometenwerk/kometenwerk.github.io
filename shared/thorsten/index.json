   "dauer": 2.98,
   "hash": "6eb40600c573"
  },
  {
   "id": "sieg-3",
   "gruppe": "sieg",
   "text": "Wir haben gewonnen! Tanzpause!",
   "datei": "ton/sieg-3.mp3",
   "dauer": 1.93,
   "hash": "9a0203eb572d"
  },
  {
   "id": "sieg-4",
   "gruppe": "sieg",
   "text": "Und das, liebe Leute, nennt man Krawall!",
   "datei": "ton/sieg-4.mp3",
   "dauer": 2.59,
   "hash": "5559964ee71c"
  },
  {
   "id": "platz-1",
   "gruppe": "platz",
   "text": "Nicht ganz der Sieg, aber ein richtig guter Platz!",
   "datei": "ton/platz-1.mp3",
   "dauer": 2.4,
   "hash": "a800c956742d"
  },
  {
   "id": "platz-2",
   "gruppe": "platz",
   "text": "Knapp vorbei. Nächstes Mal schnappe ich mir den ersten Platz!",
