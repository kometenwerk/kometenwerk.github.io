   "dauer": 1.52,
   "hash": "56f316cb7fc2"
  },
  {
   "id": "raus-5",
   "gruppe": "ko_raus",
   "text": "Uff. Kurze Pause für mein Fell.",
   "datei": "ton/raus-5.mp3",
   "dauer": 1.83,
   "hash": "b1a15257f610"
  },
  {
   "id": "andere-1",
   "gruppe": "ko_andere",
   "text": "Und da kippt der Nächste um!",
   "datei": "ton/andere-1.mp3",
   "dauer": 1.31,
   "hash": "c9ba3a011f0d"
  },
  {
   "id": "andere-2",
   "gruppe": "ko_andere",
   "text": "Oh, das war ein Volltreffer!",
   "datei": "ton/andere-2.mp3",
   "dauer": 1.59,
   "hash": "787cb901eb2e"
  },
  {
   "id": "andere-3",
   "gruppe": "ko_andere",
   "text": "Uiuiui, das ging schnell.",
   "datei": "ton/andere-3.mp3",
   "dauer": 1.7,
   "hash": "9f1a0e99ec9d"
  },
  {
   "id": "andere-4",
   "gruppe": "ko_andere",
   "text": "Hier wird ordentlich aufgeräumt!",
   "datei": "ton/andere-4.mp3",
   "dauer": 1.65,
   "hash": "3328d0ee5c13"
  },
  {
   "id": "andere-5",
   "gruppe": "ko_andere",
   "text": "Gut, dass das nicht ich war.",
   "datei": "ton/andere-5.mp3",
   "dauer": 1.31,
   "hash": "7bc9614670dd"
  },
  {
   "id": "super-ich-1",
   "gruppe": "super_ich",
   "text": "Spezialattacke, jetzt!",
   "datei": "ton/super-ich-1.mp3",
   "dauer": 1.59,
   "hash": "ec276283c0be"
  },
  {
   "id": "super-ich-2",
   "gruppe": "super_ich",
   "text": "Zeit für meine Geheimwaffe!",
   "datei": "ton/super-ich-2.mp3",
   "dauer": 1.46,
   "hash": "741935a6e494"
  },
  {
   "id": "super-ich-3",
   "gruppe": "super_ich",
   "text": "Und jetzt die ganze Power!",
   "datei": "ton/super-ich-3.mp3",
   "dauer": 1.36,
   "hash": "32a5c54f69e1"
  },
  {
   "id": "super-ich-4",
   "gruppe": "super_ich",
   "text": "Achtung, aus dem Weg!",
   "datei": "ton/super-ich-4.mp3",
   "dauer": 1.28,
   "hash": "c37f5eade6fc"
  },
  {
   "id": "super-andere-1",
   "gruppe": "super_andere",
   "text": "Vorsicht, Spezialattacke!",
   "datei": "ton/super-andere-1.mp3",
   "dauer": 1.52,
   "hash": "a1bbc03a1e0e"
  },
  {
   "id": "super-andere-2",
   "gruppe": "super_andere",
   "text": "Woah, was war das denn?",
   "datei": "ton/super-andere-2.mp3",
   "dauer": 1.38,
   "hash": "b98abfa53bdd"
  },
  {
   "id": "super-andere-3",
   "gruppe": "super_andere",
   "text": "Ohhh, die sah gefährlich aus!",
   "datei": "ton/super-andere-3.mp3",
   "dauer": 1.59,
   "hash": "e82f6c172926"
  },
  {
   "id": "item-herz",
   "gruppe": "item_herz",
   "text": "Ein Herz! Das kommt gerade richtig.",
   "datei": "ton/item-herz.mp3",
   "dauer": 2.04,
   "hash": "ad7dfa058517"
  },
  {
   "id": "item-blitz",
