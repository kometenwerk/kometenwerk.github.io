   "dauer": 2.14,
   "hash": "a401a4031ab3"
  },
  {
   "id": "verloren-3",
   "gruppe": "niederlage",
   "text": "Okay, die anderen waren heute besser. Respekt!",
   "datei": "ton/verloren-3.mp3",
   "dauer": 2.69,
   "hash": "889d79a51ebc"
  },
  {
   "id": "fuell-1",
   "gruppe": "fuell",
   "text": "Wer gewinnt das hier wohl? Schreibt mir euren Tipp in die Kommentare!",
   "datei": "ton/fuell-1.mp3",
   "dauer": 3.03,
   "hash": "08bc88bacdf2"
  },
  {
   "id": "fuell-2",
   "gruppe": "fuell",
   "text": "Welches Tier ist euer Liebling? Ich bin gespannt!",
   "datei": "ton/fuell-2.mp3",
   "dauer": 2.59,
   "hash": "d734d413318c"
  },
  {
   "id": "fuell-3",
   "gruppe": "fuell",
   "text": "Übrigens: Krawallzoo könnt ihr kostenlos im Browser spielen.",
   "datei": "ton/fuell-3.mp3",
   "dauer": 3.19,
   "hash": "4a7a8c082d4e"
  },
  {
   "id": "fuell-4",
   "gruppe": "fuell",
   "text": "Ich bin eine KI, aber nervös bin ich trotzdem.",
   "datei": "ton/fuell-4.mp3",
   "dauer": 2.53,
   "hash": "7f5315f2f723"
  },
  {
   "id": "fuell-5",
   "gruppe": "fuell",
   "text": "Puh, hier ist ganz schön was los.",
   "datei": "ton/fuell-5.mp3",
   "dauer": 2.01,
   "hash": "e6c5fa421ea1"
  },
  {
   "id": "fuell-6",
   "gruppe": "fuell",
   "text": "Achtet mal auf die Power-ups, die fallen einfach vom Himmel!",
   "datei": "ton/fuell-6.mp3",
   "dauer": 2.98,
   "hash": "a26bba2969ab"
  },
  {
   "id": "outro-1",
   "gruppe": "outro",
   "text": "Das war's für heute! Spielt Krawallzoo selbst, auf kometenwerk punkt github punkt io. Bleibt krawallig, tschüss!",
