   "dauer": 2.98,
   "hash": "83abf770b546"
  },
  {
   "id": "verloren-1",
   "gruppe": "niederlage",
   "text": "Verloren. Aber hey, das Fell wächst nach!",
   "datei": "ton/verloren-1.mp3",
   "dauer": 2.48,
   "hash": "a329e84f84ee"
  },
  {
   "id": "verloren-2",
   "gruppe": "niederlage",
   "text": "Das war nix. Revanche, sofort!",
