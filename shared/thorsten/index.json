   "dauer": 1.52,
   "hash": "027df5c0540e"
  },
  {
   "id": "los-1",
   "gruppe": "los",
   "text": "Und los!",
   "datei": "ton/los-1.mp3",
   "dauer": 0.76,
   "hash": "1b041bc28686"
  },
  {
   "id": "los-2",
   "gruppe": "los",
   "text": "Drei, zwei, eins, Krawall!",
   "datei": "ton/los-2.mp3",
   "dauer": 2.35,
   "hash": "8c76d57de9cd"
  },
  {
   "id": "los-3",
   "gruppe": "los",
   "text": "Okay, Konzentration. Jetzt geht's los!",
   "datei": "ton/los-3.mp3",
   "dauer": 2.64,
   "hash": "e4fd084b1549"
  },
  {
   "id": "los-4",
   "gruppe": "los",
   "text": "Neue Runde, neues Glück!",
   "datei": "ton/los-4.mp3",
   "dauer": 1.59,
   "hash": "b12d07e09383"
  },
  {
   "id": "treffer-1",
   "gruppe": "ko_treffer",
   "text": "Ja! Erwischt!",
   "datei": "ton/treffer-1.mp3",
   "dauer": 1.2,
   "hash": "503272f0b1de"
  },
  {
   "id": "treffer-2",
   "gruppe": "ko_treffer",
   "text": "Den hab ich umgehauen!",
   "datei": "ton/treffer-2.mp3",
   "dauer": 1.23,
   "hash": "ea674f8575ed"
  },
  {
   "id": "treffer-3",
   "gruppe": "ko_treffer",
   "text": "Boom! Der ist raus!",
   "datei": "ton/treffer-3.mp3",
   "dauer": 1.31,
   "hash": "1cc957426e8a"
  },
  {
   "id": "treffer-4",
   "gruppe": "ko_treffer",
   "text": "Einer weniger, weiter so!",
   "datei": "ton/treffer-4.mp3",
   "dauer": 1.44,
   "hash": "d3d3fcf8c107"
  },
  {
   "id": "treffer-5",
   "gruppe": "ko_treffer",
   "text": "Sauber! Das war mein Moment!",
   "datei": "ton/treffer-5.mp3",
   "dauer": 1.72,
   "hash": "2bcb1c483a3d"
  },
  {
   "id": "treffer-6",
   "gruppe": "ko_treffer",
   "text": "Haha, damit hat er nicht gerechnet!",
   "datei": "ton/treffer-6.mp3",
   "dauer": 1.83,
   "hash": "2a45a0363d8b"
  },
  {
   "id": "raus-1",
   "gruppe": "ko_raus",
   "text": "Nein! Mein Tier ist raus!",
   "datei": "ton/raus-1.mp3",
   "dauer": 1.62,
   "hash": "72ab7b7ae622"
  },
  {
   "id": "raus-2",
   "gruppe": "ko_raus",
   "text": "Autsch. Das hat wehgetan.",
   "datei": "ton/raus-2.mp3",
   "dauer": 1.67,
   "hash": "7360db110241"
  },
  {
   "id": "raus-3",
   "gruppe": "ko_raus",
   "text": "Okay, das war nicht mein bester Moment.",
   "datei": "ton/raus-3.mp3",
   "dauer": 2.06,
   "hash": "9f1ef7a921d6"
  },
  {
   "id": "raus-4",
   "gruppe": "ko_raus",
   "text": "Wer hat mich da bitte erwischt?",
   "datei": "ton/raus-4.mp3",
   "dauer": 1.52,
   "hash": "56f316cb7fc2"
  },
  {
   "id": "raus-5",
   "gruppe": "ko_raus",
   "text": "Uff. Kurze Pause für mein Fell.",
   "datei": "ton/raus-5.mp3",
   "dauer": 1.83,
   "hash": "b1a15257f610"
  },
  {
   "id": "andere-1",
   "gruppe": "ko_andere",
   "text": "Und da kippt der Nächste um!",
   "datei": "ton/andere-1.mp3",
   "dauer": 1.31,
   "hash": "c9ba3a011f0d"
  },
  {
   "id": "andere-2",
   "gruppe": "ko_andere",
   "text": "Oh, das war ein Volltreffer!",
   "datei": "ton/andere-2.mp3",
   "dauer": 1.59,
   "hash": "787cb901eb2e"
  },
  {
   "id": "andere-3",
   "gruppe": "ko_andere",
   "text": "Uiuiui, das ging schnell.",
   "datei": "ton/andere-3.mp3",
   "dauer": 1.7,
   "hash": "9f1a0e99ec9d"
  },
  {
   "id": "andere-4",
   "gruppe": "ko_andere",
   "text": "Hier wird ordentlich aufgeräumt!",
   "datei": "ton/andere-4.mp3",
   "dauer": 1.65,
   "hash": "3328d0ee5c13"
  },
  {
   "id": "andere-5",
   "gruppe": "ko_andere",
   "text": "Gut, dass das nicht ich war.",
   "datei": "ton/andere-5.mp3",
   "dauer": 1.31,
   "hash": "7bc9614670dd"
  },
  {
   "id": "super-ich-1",
   "gruppe": "super_ich",
   "text": "Spezialattacke, jetzt!",
   "datei": "ton/super-ich-1.mp3",
   "dauer": 1.59,
   "hash": "ec276283c0be"
  },
  {
   "id": "super-ich-2",
   "gruppe": "super_ich",
   "text": "Zeit für meine Geheimwaffe!",
   "datei": "ton/super-ich-2.mp3",
   "dauer": 1.46,
   "hash": "741935a6e494"
  },
  {
   "id": "super-ich-3",
   "gruppe": "super_ich",
   "text": "Und jetzt die ganze Power!",
   "datei": "ton/super-ich-3.mp3",
   "dauer": 1.36,
   "hash": "32a5c54f69e1"
  },
  {
   "id": "super-ich-4",
   "gruppe": "super_ich",
   "text": "Achtung, aus dem Weg!",
   "datei": "ton/super-ich-4.mp3",
   "dauer": 1.28,
   "hash": "c37f5eade6fc"
  },
  {
   "id": "super-andere-1",
   "gruppe": "super_andere",
   "text": "Vorsicht, Spezialattacke!",
   "datei": "ton/super-andere-1.mp3",
   "dauer": 1.52,
   "hash": "a1bbc03a1e0e"
  },
  {
   "id": "super-andere-2",
   "gruppe": "super_andere",
   "text": "Woah, was war das denn?",
   "datei": "ton/super-andere-2.mp3",
   "dauer": 1.38,
   "hash": "b98abfa53bdd"
  },
  {
   "id": "super-andere-3",
   "gruppe": "super_andere",
   "text": "Ohhh, die sah gefährlich aus!",
   "datei": "ton/super-andere-3.mp3",
   "dauer": 1.59,
   "hash": "e82f6c172926"
  },
  {
   "id": "item-herz",
   "gruppe": "item_herz",
   "text": "Ein Herz! Das kommt gerade richtig.",
   "datei": "ton/item-herz.mp3",
   "dauer": 2.04,
   "hash": "ad7dfa058517"
  },
  {
   "id": "item-blitz",
   "gruppe": "item_blitz",
   "text": "Turbo! Jetzt wird's schnell.",
   "datei": "ton/item-blitz.mp3",
   "dauer": 1.49,
   "hash": "819ddf94213c"
  },
  {
   "id": "item-kristall",
   "gruppe": "item_kristall",
   "text": "Power-Kristall! Gleich gibt's Ärger.",
   "datei": "ton/item-kristall.mp3",
   "dauer": 2.22,
   "hash": "2a3b82046b1d"
  },
  {
   "id": "item-schild",
   "gruppe": "item_schild",
   "text": "Schild an. Kommt doch her!",
   "datei": "ton/item-schild.mp3",
   "dauer": 1.52,
   "hash": "bdf6619ce3a2"
  },
  {
   "id": "nebel-1",
   "gruppe": "nebel",
   "text": "Der Nebel kommt! Ab in die Mitte!",
   "datei": "ton/nebel-1.mp3",
   "dauer": 1.8,
   "hash": "8dc0ef5011e1"
  },
  {
   "id": "nebel-2",
   "gruppe": "nebel",
   "text": "Es wird eng. Jetzt bloß nicht im Nebel stehen!",
   "datei": "ton/nebel-2.mp3",
   "dauer": 2.64,
   "hash": "01f8a967331b"
  },
  {
   "id": "runde-1",
   "gruppe": "runde",
   "text": "Nächste Runde! Jetzt aber richtig.",
   "datei": "ton/runde-1.mp3",
   "dauer": 1.91,
   "hash": "5cc46341d977"
  },
  {
   "id": "runde-2",
   "gruppe": "runde",
   "text": "Weiter geht's, Runde zwei!",
   "datei": "ton/runde-2.mp3",
   "dauer": 1.78,
   "hash": "1e8ea2ae525e"
  },
  {
   "id": "entscheidung-1",
   "gruppe": "entscheidung",
   "text": "Entscheidungsrunde! Jetzt zählt jeder Treffer!",
   "datei": "ton/entscheidung-1.mp3",
   "dauer": 2.43,
   "hash": "fcfc25deef50"
  },
  {
   "id": "sieg-1",
   "gruppe": "sieg",
   "text": "Ja! Gewonnen! Was für eine Runde!",
   "datei": "ton/sieg-1.mp3",
   "dauer": 2.32,
   "hash": "f9af260dfb44"
  },
  {
   "id": "sieg-2",
   "gruppe": "sieg",
   "text": "Sieg! Ich wusste es. Okay, ich hab's gehofft.",
   "datei": "ton/sieg-2.mp3",
   "dauer": 2.98,
   "hash": "6eb40600c573"
  },
  {
   "id": "sieg-3",
   "gruppe": "sieg",
   "text": "Wir haben gewonnen! Tanzpause!",
   "datei": "ton/sieg-3.mp3",
   "dauer": 1.93,
   "hash": "9a0203eb572d"
  },
  {
   "id": "sieg-4",
   "gruppe": "sieg",
   "text": "Und das, liebe Leute, nennt man Krawall!",
   "datei": "ton/sieg-4.mp3",
   "dauer": 2.59,
   "hash": "5559964ee71c"
  },
  {
   "id": "platz-1",
   "gruppe": "platz",
   "text": "Nicht ganz der Sieg, aber ein richtig guter Platz!",
   "datei": "ton/platz-1.mp3",
   "dauer": 2.4,
   "hash": "a800c956742d"
  },
  {
   "id": "platz-2",
   "gruppe": "platz",
   "text": "Knapp vorbei. Nächstes Mal schnappe ich mir den ersten Platz!",
   "datei": "ton/platz-2.mp3",
   "dauer": 2.98,
   "hash": "83abf770b546"
  },
  {
   "id": "verloren-1",
   "gruppe": "niederlage",
   "text": "Verloren. Aber hey, das Fell wächst nach!",
   "datei": "ton/verloren-1.mp3",
   "dauer": 2.48,
   "hash": "a329e84f84ee"
  },
  {
   "id": "verloren-2",
   "gruppe": "niederlage",
   "text": "Das war nix. Revanche, sofort!",
   "datei": "ton/verloren-2.mp3",
   "dauer": 2.14,
   "hash": "a401a4031ab3"
  },
  {
   "id": "verloren-3",
   "gruppe": "niederlage",
   "text": "Okay, die anderen waren heute besser. Respekt!",
   "datei": "ton/verloren-3.mp3",
   "dauer": 2.69,
   "hash": "889d79a51ebc"
  },
  {
   "id": "fuell-1",
   "gruppe": "fuell",
   "text": "Wer gewinnt das hier wohl? Schreibt mir euren Tipp in die Kommentare!",
   "datei": "ton/fuell-1.mp3",
   "dauer": 3.03,
   "hash": "08bc88bacdf2"
  },
  {
   "id": "fuell-2",
   "gruppe": "fuell",
   "text": "Welches Tier ist euer Liebling? Ich bin gespannt!",
   "datei": "ton/fuell-2.mp3",
   "dauer": 2.59,
   "hash": "d734d413318c"
  },
  {
   "id": "fuell-3",
   "gruppe": "fuell",
   "text": "Übrigens: Krawallzoo könnt ihr kostenlos im Browser spielen.",
   "datei": "ton/fuell-3.mp3",
   "dauer": 3.19,
   "hash": "4a7a8c082d4e"
  },
  {
   "id": "fuell-4",
   "gruppe": "fuell",
   "text": "Ich bin eine KI, aber nervös bin ich trotzdem.",
   "datei": "ton/fuell-4.mp3",
   "dauer": 2.53,
   "hash": "7f5315f2f723"
  },
  {
   "id": "fuell-5",
   "gruppe": "fuell",
   "text": "Puh, hier ist ganz schön was los.",
   "datei": "ton/fuell-5.mp3",
   "dauer": 2.01,
   "hash": "e6c5fa421ea1"
  },
  {
   "id": "fuell-6",
   "gruppe": "fuell",
   "text": "Achtet mal auf die Power-ups, die fallen einfach vom Himmel!",
   "datei": "ton/fuell-6.mp3",
   "dauer": 2.98,
   "hash": "a26bba2969ab"
  },
  {
   "id": "outro-1",
   "gruppe": "outro",
   "text": "Das war's für heute! Spielt Krawallzoo selbst, auf kometenwerk punkt github punkt io. Bleibt krawallig, tschüss!",
   "datei": "ton/outro-1.mp3",
   "dauer": 6.3,
   "hash": "a6e79b8c6081"
  },
  {
   "id": "outro-2",
   "gruppe": "outro",
   "text": "Danke fürs Zuschauen! Wenn's euch gefallen hat, lasst gern ein Like da. Bleibt krawallig!",
   "datei": "ton/outro-2.mp3",
   "dauer": 5.04,
   "hash": "33bd884aafa7"
  },
  {
   "id": "outro-short",
   "gruppe": "short_outro",
   "text": "Bleibt krawallig!",
   "datei": "ton/outro-short.mp3",
   "dauer": 0.99,
   "hash": "65686d16198a"
  },
  {
   "id": "hz-intro-zeigen-1",
   "gruppe": "hz_intro_zeigen",
   "text": "Hey Leute, Thorsten hier! Heute zeige ich euch meine Stadt in Horizonte. Kommt mit auf einen Rundflug!",
   "datei": "ton/hz-intro-zeigen-1.mp3",
   "dauer": 5.41,
   "hash": "40980bbc4338"
  },
  {
   "id": "hz-intro-zeigen-2",
   "gruppe": "hz_intro_zeigen",
   "text": "Servus! Thorsten hier, eure Lieblings-KI. Heute gibt's eine Stadtführung von oben!",
   "datei": "ton/hz-intro-zeigen-2.mp3",
   "dauer": 4.99,
   "hash": "046c84502c68"
  },
  {
   "id": "hz-intro-bauen-1",
   "gruppe": "hz_intro_bauen",
   "text": "Hey Leute, Thorsten hier! Heute baue ich eine ganze Stadt. Aus dem Nichts. Los geht's!",
   "datei": "ton/hz-intro-bauen-1.mp3",
   "dauer": 4.99,
   "hash": "aaf862ddc022"
  },
  {
   "id": "hz-intro-bauen-2",
   "gruppe": "hz_intro_bauen",
   "text": "Hallo zusammen! Leeres Land, viel Geld und eine KI mit Plänen. Was kann da schon schiefgehen?",
   "datei": "ton/hz-intro-bauen-2.mp3",
   "dauer": 5.25,
   "hash": "029dd772f2df"
  },
  {
   "id": "hz-short-1",
   "gruppe": "hz_short_intro",
   "text": "Thorsten hier. Schaut euch diese Stadt an!",
   "datei": "ton/hz-short-1.mp3",
   "dauer": 2.35,
   "hash": "0bf01e0a12ca"
  },
  {
   "id": "hz-short-2",
   "gruppe": "hz_short_intro",
   "text": "Eine Stadt im Zeitraffer. Los!",
   "datei": "ton/hz-short-2.mp3",
   "dauer": 1.91,
   "hash": "5033cf36f990"
  },
  {
   "id": "hz-uebersicht-1",
   "gruppe": "hz_uebersicht",
   "text": "Das ist sie, meine Stadt. Von hier oben sieht alles so ordentlich aus.",
   "datei": "ton/hz-uebersicht-1.mp3",
   "dauer": 3.79,
   "hash": "6e98fa4afd22"
  },
  {
   "id": "hz-uebersicht-2",
   "gruppe": "hz_uebersicht",
   "text": "Erst mal ein Überblick. Hier wohnen, arbeiten und stauen sich meine Leute.",
   "datei": "ton/hz-uebersicht-2.mp3",
   "dauer": 3.74,
   "hash": "50e377f43d60"
  },
  {
   "id": "hz-hochhaus-1",
   "gruppe": "hz_hochhaus",
   "text": "Schaut mal, wie hoch das Ding ist! Da will ich ganz oben wohnen.",
   "datei": "ton/hz-hochhaus-1.mp3",
   "dauer": 3.19,
   "hash": "8a9b6465b43e"
  },
  {
   "id": "hz-hochhaus-2",
   "gruppe": "hz_hochhaus",
   "text": "Hier stehen die großen Häuser. Meine kleine Skyline!",
   "datei": "ton/hz-hochhaus-2.mp3",
   "dauer": 2.77,
   "hash": "2e76c4a00015"
  },
  {
   "id": "hz-haeuser-1",
   "gruppe": "hz_haeuser",
   "text": "Gemütliche Häuschen, kleine Gärten. Richtig schön hier.",
   "datei": "ton/hz-haeuser-1.mp3",
   "dauer": 3.32,
   "hash": "9d82cbb5b20d"
  },
  {
   "id": "hz-haeuser-2",
   "gruppe": "hz_haeuser",
   "text": "Hier wohnen die Leute. Und ja, jedes Haus ist echt gewachsen.",
   "datei": "ton/hz-haeuser-2.mp3",
   "dauer": 3.55,
   "hash": "fa91b4bf454e"
  },
  {
   "id": "hz-bahnhof-1",
   "gruppe": "hz_bahnhof",
   "text": "Der Bahnhof! Wenn ihr Glück habt, fährt gleich ein Zug ein.",
   "datei": "ton/hz-bahnhof-1.mp3",
   "dauer": 3.03,
   "hash": "c12125c1f2cc"
  },
  {
   "id": "hz-bahnhof-2",
   "gruppe": "hz_bahnhof",
   "text": "Hier halten die Züge. Pünktlicher als im echten Leben, versprochen.",
   "datei": "ton/hz-bahnhof-2.mp3",
   "dauer": 3.55,
   "hash": "98fa0dfb12e2"
  },
  {
   "id": "hz-hafen-1",
   "gruppe": "hz_hafen",
   "text": "Ahoi! Am Hafen ist immer was los.",
   "datei": "ton/hz-hafen-1.mp3",
   "dauer": 2.32,
   "hash": "c309580196bd"
  },
  {
   "id": "hz-hafen-2",
   "gruppe": "hz_hafen",
   "text": "Schiffe, Kräne, Wasser. Ich liebe den Hafen.",
   "datei": "ton/hz-hafen-2.mp3",
   "dauer": 2.74,
   "hash": "f6ab602add36"
  },
  {
   "id": "hz-flughafen-1",
   "gruppe": "hz_flughafen",
   "text": "Und hier der Flughafen. Gleich hebt ein Flieger ab!",
   "datei": "ton/hz-flughafen-1.mp3",
   "dauer": 2.56,
   "hash": "2e2116659d07"
  },
  {
   "id": "hz-flughafen-2",
   "gruppe": "hz_flughafen",
   "text": "Bitte anschnallen, wir sind am Flughafen!",
   "datei": "ton/hz-flughafen-2.mp3",
   "dauer": 2.3,
   "hash": "a33b47ee503d"
  },
  {
   "id": "hz-bus-1",
   "gruppe": "hz_bus",
   "text": "Der Bus bringt alle zur Arbeit. Hoffentlich ohne Stau.",
   "datei": "ton/hz-bus-1.mp3",
   "dauer": 3.0,
   "hash": "d28b63f204a8"
  },
  {
   "id": "hz-auto-1",
   "gruppe": "hz_auto",
   "text": "Ich hänge mich mal an ein Auto dran. Mal sehen, wo es hinfährt.",
   "datei": "ton/hz-auto-1.mp3",
   "dauer": 3.24,
   "hash": "bdcaf8d3e1b3"
  },
  {
   "id": "hz-auto-2",
   "gruppe": "hz_auto",
   "text": "Wir fahren mit! Bitte nicht zu schnell, liebe Fahrerin.",
   "datei": "ton/hz-auto-2.mp3",
   "dauer": 2.77,
   "hash": "88e44ea85b60"
  },
  {
   "id": "hz-nacht-1",
   "gruppe": "hz_nacht",
   "text": "Und jetzt wird's Nacht. Schaut euch diese Lichter an!",
   "datei": "ton/hz-nacht-1.mp3",
   "dauer": 2.51,
   "hash": "d0c1747595e7"
  },
  {
   "id": "hz-nacht-2",
   "gruppe": "hz_nacht",
   "text": "Bei Nacht ist meine Stadt am schönsten. Überall leuchten die Fenster.",
   "datei": "ton/hz-nacht-2.mp3",
   "dauer": 3.27,
   "hash": "597a91a13a0d"
  },
  {
   "id": "hz-land-1",
   "gruppe": "hz_land",
   "text": "Hier ist noch nichts. Nur Gras und Bäume. Noch!",
   "datei": "ton/hz-land-1.mp3",
   "dauer": 2.66,
   "hash": "d8700112b265"
  },
  {
   "id": "hz-land-2",
   "gruppe": "hz_land",
   "text": "Leeres Land. Hier wird gleich gebaut.",
   "datei": "ton/hz-land-2.mp3",
   "dauer": 2.14,
   "hash": "e22f03708688"
  },
  {
   "id": "hz-strassen-1",
   "gruppe": "hz_strassen",
   "text": "Zuerst die Straßen. Ohne Straßen keine Stadt.",
   "datei": "ton/hz-strassen-1.mp3",
   "dauer": 2.51,
   "hash": "ed6041a9ff91"
  },
  {
   "id": "hz-strassen-2",
   "gruppe": "hz_strassen",
   "text": "Straße hier, Straße da. Ich bin quasi Bauarbeiter.",
   "datei": "ton/hz-strassen-2.mp3",
   "dauer": 3.19,
   "hash": "2dbb529b97e4"
  },
  {
   "id": "hz-strom-1",
   "gruppe": "hz_strom",
   "text": "Windräder für den Strom. Sauber und leise.",
   "datei": "ton/hz-strom-1.mp3",
   "dauer": 2.53,
   "hash": "951f20f7f38d"
  },
  {
   "id": "hz-wasser-1",
   "gruppe": "hz_wasser",
   "text": "Ein Wasserturm, damit niemand durstig bleibt.",
   "datei": "ton/hz-wasser-1.mp3",
   "dauer": 2.61,
   "hash": "5a3415f34d36"
  },
  {
   "id": "hz-muell-1",
   "gruppe": "hz_muell",
   "text": "Und eine Deponie. Irgendwo muss der Müll ja hin.",
   "datei": "ton/hz-muell-1.mp3",
   "dauer": 2.48,
   "hash": "6cebaea368ae"
  },
  {
   "id": "hz-dienste-1",
   "gruppe": "hz_dienste",
   "text": "Feuerwehr, Polizei und ein Arzt. Sicherheit geht vor!",
   "datei": "ton/hz-dienste-1.mp3",
   "dauer": 3.27,
   "hash": "507785246d9c"
  },
  {
   "id": "hz-schule-1",
   "gruppe": "hz_schule",
   "text": "Eine Schule! Auch in meiner Stadt wird gelernt.",
   "datei": "ton/hz-schule-1.mp3",
   "dauer": 2.35,
   "hash": "8b6f3b50242b"
  },
  {
   "id": "hz-park-1",
   "gruppe": "hz_park",
   "text": "Ein Park und ein Spielplatz. Für gute Laune.",
   "datei": "ton/hz-park-1.mp3",
   "dauer": 2.64,
   "hash": "384209f4b464"
  },
  {
   "id": "hz-zonen-1",
   "gruppe": "hz_zonen",
   "text": "Jetzt male ich die Zonen. Grün heißt wohnen, blau heißt einkaufen.",
   "datei": "ton/hz-zonen-1.mp3",
   "dauer": 3.66,
   "hash": "51bab60349ed"
  },
  {
   "id": "hz-zonen-2",
   "gruppe": "hz_zonen",
   "text": "Zonen malen. Ab hier dürfen die Leute selbst bauen.",
   "datei": "ton/hz-zonen-2.mp3",
   "dauer": 2.85,
   "hash": "35acfa439fc2"
  },
  {
   "id": "hz-wachsen-1",
   "gruppe": "hz_wachsen",
   "text": "Und jetzt: Zeitraffer! Schaut, wie die Häuser wachsen!",
   "datei": "ton/hz-wachsen-1.mp3",
   "dauer": 3.03,
   "hash": "18e55e3a20c5"
  },
  {
   "id": "hz-wachsen-2",
   "gruppe": "hz_wachsen",
   "text": "Die ersten Leute ziehen ein. Willkommen in meiner Stadt!",
   "datei": "ton/hz-wachsen-2.mp3",
   "dauer": 2.8,
   "hash": "4711cfb6de1e"
  },
  {
   "id": "hz-busbau-1",
   "gruppe": "hz_bus",
   "text": "Jetzt noch eine Buslinie, damit nicht jeder mit dem Auto fährt.",
   "datei": "ton/hz-busbau-1.mp3",
   "dauer": 3.19,
   "hash": "b9f0d974423a"
  },
  {
   "id": "hz-erweiterung-1",
   "gruppe": "hz_erweiterung",
   "text": "Die Stadt ist zu klein. Wir brauchen mehr Platz!",
   "datei": "ton/hz-erweiterung-1.mp3",
   "dauer": 2.43,
   "hash": "3491f685239d"
  },
  {
   "id": "hz-erweiterung-2",
   "gruppe": "hz_erweiterung",
   "text": "Neues Viertel, größere Häuser. Jetzt wird's ernst.",
   "datei": "ton/hz-erweiterung-2.mp3",
   "dauer": 3.34,
   "hash": "66d0d0158dfd"
  },
  {
   "id": "hz-zonen2-1",
   "gruppe": "hz_zonen2",
   "text": "Diesmal mit Hochhäusern, Läden und Büros.",
   "datei": "ton/hz-zonen2-1.mp3",
   "dauer": 2.43,
   "hash": "7309e84ab7af"
  },
  {
   "id": "hz-wachsen2-1",
   "gruppe": "hz_wachsen2",
   "text": "Und wieder Zeitraffer. Aus dem Dorf wird eine richtige Stadt!",
   "datei": "ton/hz-wachsen2-1.mp3",
   "dauer": 3.21,
   "hash": "4b3dd491c057"
  },
  {
   "id": "hz-wachsen2-2",
   "gruppe": "hz_wachsen2",
   "text": "Seht ihr die Kräne? Da entsteht gerade was Großes.",
   "datei": "ton/hz-wachsen2-2.mp3",
   "dauer": 2.51,
   "hash": "e01ce8663d96"
  },
  {
   "id": "hz-einw-25",
   "gruppe": "hz_einwohner",
   "text": "Die ersten fünfundzwanzig Einwohner!",
   "datei": "ton/hz-einw-25.mp3",
   "dauer": 1.91,
   "hash": "3a96377cbb69",
   "zahl": 25
  },
  {
   "id": "hz-einw-60",
   "gruppe": "hz_einwohner",
   "text": "Schon sechzig Leute wohnen hier!",
   "datei": "ton/hz-einw-60.mp3",
   "dauer": 1.59,
   "hash": "f1ce8797e405",
   "zahl": 60
  },
  {
   "id": "hz-einw-120",
   "gruppe": "hz_einwohner",
   "text": "Über hundert Einwohner! Das ist schon ein Dorf.",
   "datei": "ton/hz-einw-120.mp3",
   "dauer": 2.27,
   "hash": "d25f7d6b16c0",
   "zahl": 120
  },
  {
   "id": "hz-einw-250",
   "gruppe": "hz_einwohner",
   "text": "Zweihundertfünfzig Einwohner! Es läuft.",
   "datei": "ton/hz-einw-250.mp3",
   "dauer": 2.38,
   "hash": "1a76611aafe9",
   "zahl": 250
  },
  {
   "id": "hz-einw-500",
   "gruppe": "hz_einwohner",
   "text": "Fünfhundert Einwohner! Meine Stadt wird groß.",
   "datei": "ton/hz-einw-500.mp3",
   "dauer": 2.35,
   "hash": "f42952421980",
   "zahl": 500
  },
  {
   "id": "hz-einw-1000",
   "gruppe": "hz_einwohner",
   "text": "Tausend Einwohner! Party im Rathaus!",
   "datei": "ton/hz-einw-1000.mp3",
   "dauer": 2.09,
   "hash": "b2f8328caf62",
   "zahl": 1000
  },
  {
   "id": "hz-einw-2000",
   "gruppe": "hz_einwohner",
   "text": "Zweitausend Leute! Ich bin stolz auf euch.",
   "datei": "ton/hz-einw-2000.mp3",
   "dauer": 2.51,
   "hash": "f02e4c360c2e",
   "zahl": 2000
  },
  {
   "id": "hz-einw-5000",
   "gruppe": "hz_einwohner",
   "text": "Fünftausend Einwohner! Das ist eine richtige Stadt.",
   "datei": "ton/hz-einw-5000.mp3",
   "dauer": 2.8,
   "hash": "ea9734a8359a",
   "zahl": 5000
  },
  {
   "id": "hz-fuell-1",
   "gruppe": "hz_fuell",
   "text": "Wie würdet ihr eure Stadt nennen? Schreibt's in die Kommentare!",
   "datei": "ton/hz-fuell-1.mp3",
   "dauer": 2.9,
   "hash": "2b71b11a9b3a"
  },
  {
   "id": "hz-fuell-2",
   "gruppe": "hz_fuell",
   "text": "Horizonte könnt ihr übrigens kostenlos im Browser spielen.",
   "datei": "ton/hz-fuell-2.mp3",
   "dauer": 3.13,
   "hash": "8dc2b72d6d5a"
  },
  {
   "id": "hz-fuell-3",
   "gruppe": "hz_fuell",
   "text": "Ich frage mich, wo all die Autos eigentlich hinfahren.",
   "datei": "ton/hz-fuell-3.mp3",
   "dauer": 2.48,
   "hash": "e0e613e367ab"
  },
  {
   "id": "hz-fuell-4",
   "gruppe": "hz_fuell",
   "text": "Was soll ich als Nächstes bauen? Einen Flughafen? Einen Zoo?",
   "datei": "ton/hz-fuell-4.mp3",
   "dauer": 3.45,
   "hash": "72dc3526d2c5"
  },
  {
   "id": "hz-fuell-5",
   "gruppe": "hz_fuell",
   "text": "Kein Stau. Noch nicht.",
   "datei": "ton/hz-fuell-5.mp3",
   "dauer": 1.54,
   "hash": "7f2d1214d3a0"
  },
  {
   "id": "hz-outro-1",
   "gruppe": "hz_outro",
   "text": "Das war meine Stadt für heute! Baut eure eigene auf kometenwerk punkt github punkt io. Bis zum nächsten Mal!",
   "datei": "ton/hz-outro-1.mp3",
   "dauer": 5.56,
   "hash": "26a9cfa1ed6a"
  },
  {
   "id": "hz-outro-2",
   "gruppe": "hz_outro",
   "text": "Danke fürs Zuschauen! Wenn's euch gefallen hat, lasst ein Like da. Tschüss!",
   "datei": "ton/hz-outro-2.mp3",
   "dauer": 4.1,
   "hash": "480388e64a12"
  },
  {
   "id": "hz-outro-short",
   "gruppe": "hz_short_outro",
   "text": "Bis zum nächsten Mal!",
   "datei": "ton/hz-outro-short.mp3",
   "dauer": 1.18,
   "hash": "e26133fa06ab"
  },
  {
   "id": "hz-problem-brand-1",
   "gruppe": "hz_problem_brand",
   "text": "Oh nein, es brennt! Feuerwehr, schnell!",
   "datei": "ton/hz-problem-brand-1.mp3",
   "dauer": 2.66,
   "hash": "45a0d6f832de"
  },
  {
   "id": "hz-problem-brand-2",
   "gruppe": "hz_problem_brand",
   "text": "Da kommt Rauch raus! Das ist kein Grillfest!",
   "datei": "ton/hz-problem-brand-2.mp3",
   "dauer": 2.51,
   "hash": "e32b7d214f23"
  },
  {
   "id": "hz-problem-stau-1",
   "gruppe": "hz_problem_stau",
   "text": "Oh nein, Stau! Ich hätte doch eine größere Straße bauen sollen.",
   "datei": "ton/hz-problem-stau-1.mp3",
   "dauer": 3.53,
   "hash": "bf49ba46de6d"
  },
  {
   "id": "hz-problem-stau-2",
   "gruppe": "hz_problem_stau",
   "text": "Hier geht gar nichts mehr. Stoßstange an Stoßstange!",
   "datei": "ton/hz-problem-stau-2.mp3",
   "dauer": 2.69,
   "hash": "6ecd718918bb"
  },
  {
   "id": "hz-problem-strom-1",
   "gruppe": "hz_problem_strom",
   "text": "Moment, warum ist es da so dunkel? Die haben keinen Strom!",
   "datei": "ton/hz-problem-strom-1.mp3",
   "dauer": 3.0,
   "hash": "15b1d4576bc2"
  },
  {
   "id": "hz-problem-strom-2",
   "gruppe": "hz_problem_strom",
   "text": "Stromausfall! Ups, das war wohl ich.",
   "datei": "ton/hz-problem-strom-2.mp3",
   "dauer": 2.48,
   "hash": "d868820b532b"
  },
  {
   "id": "hz-problem-wasser-1",
   "gruppe": "hz_problem_wasser",
   "text": "Die Leute haben kein Wasser mehr. Das ist gar nicht gut.",
   "datei": "ton/hz-problem-wasser-1.mp3",
   "dauer": 2.74,
   "hash": "afed2c05ec84"
  },
  {
   "id": "hz-problem-abwasser-1",
   "gruppe": "hz_problem_abwasser",
   "text": "Igitt, das Abwasser wird nicht abgeholt!",
   "datei": "ton/hz-problem-abwasser-1.mp3",
   "dauer": 2.14,
   "hash": "22373addd42b"
  },
  {
   "id": "hz-problem-muell-1",
   "gruppe": "hz_problem_muell",
   "text": "Hier stapelt sich der Müll. Das riecht man bis hierher!",
   "datei": "ton/hz-problem-muell-1.mp3",
   "dauer": 2.66,
   "hash": "1c328ea1b119"
  },
  {
   "id": "hz-problem-wegzug-1",
   "gruppe": "hz_problem_wegzug",
   "text": "Was? Da ziehen Leute weg! Gefällt es euch nicht bei mir?",
   "datei": "ton/hz-problem-wegzug-1.mp3",
   "dauer": 3.27,
   "hash": "72db34756665"
  },
  {
   "id": "hz-problem-krimi-1",
   "gruppe": "hz_problem_krimi",
   "text": "Hier passieren zu viele Diebstähle. Wo ist die Polizei?",
   "datei": "ton/hz-problem-krimi-1.mp3",
   "dauer": 2.95,
   "hash": "7405eda96e16"
  },
  {
   "id": "hz-problem-krank-1",
   "gruppe": "hz_problem_krank",
   "text": "Viele Leute sind krank. Wir brauchen einen Arzt!",
   "datei": "ton/hz-problem-krank-1.mp3",
   "dauer": 2.82,
   "hash": "1f9a85b6bb9d"
  },
  {
   "id": "hz-problem-1",
   "gruppe": "hz_problem",
   "text": "Oh oh. Da läuft gerade etwas schief.",
   "datei": "ton/hz-problem-1.mp3",
   "dauer": 2.06,
   "hash": "2adbadf2d1c5"
  },
  {
   "id": "hz-loesung-brand-1",
   "gruppe": "hz_loesung_brand",
   "text": "Ich baue noch eine Feuerwache. Das passiert mir nicht nochmal!",
   "datei": "ton/hz-loesung-brand-1.mp3",
   "dauer": 3.34,
   "hash": "d119f0a85bb0"
  },
  {
   "id": "hz-loesung-stau-1",
   "gruppe": "hz_loesung_stau",
   "text": "Problem erkannt! Ich mache die Straße breiter.",
   "datei": "ton/hz-loesung-stau-1.mp3",
   "dauer": 2.69,
   "hash": "3ec48572fbff"
  },
  {
   "id": "hz-loesung-stau-2",
   "gruppe": "hz_loesung_stau",
   "text": "Mehr Spuren, weniger Stau. Hoffentlich.",
   "datei": "ton/hz-loesung-stau-2.mp3",
   "dauer": 2.66,
   "hash": "940fbf8cf6a2"
  },
  {
   "id": "hz-loesung-strom-1",
   "gruppe": "hz_loesung_strom",
   "text": "Schnell noch ein Kraftwerk dazu. Licht an!",
   "datei": "ton/hz-loesung-strom-1.mp3",
   "dauer": 2.43,
   "hash": "58a4fee2a093"
  },
  {
   "id": "hz-loesung-wasser-1",
   "gruppe": "hz_loesung_wasser",
   "text": "Ein neuer Wasserturm. Prost, liebe Leute!",
   "datei": "ton/hz-loesung-wasser-1.mp3",
   "dauer": 2.53,
   "hash": "447a693066bf"
  },
  {
   "id": "hz-loesung-abwasser-1",
   "gruppe": "hz_loesung_abwasser",
   "text": "Eine Kläranlage, und das Problem ist weg.",
   "datei": "ton/hz-loesung-abwasser-1.mp3",
   "dauer": 2.56,
   "hash": "ad312eccf2f2"
  },
  {
   "id": "hz-loesung-muell-1",
   "gruppe": "hz_loesung_muell",
   "text": "Ich baue noch eine Deponie. Weg mit dem Müll!",
   "datei": "ton/hz-loesung-muell-1.mp3",
   "dauer": 2.53,
   "hash": "76d02dc8858a"
  },
  {
   "id": "hz-loesung-wegzug-1",
   "gruppe": "hz_loesung_wegzug",
   "text": "Vielleicht hilft ein schöner Park. Bitte bleibt hier!",
   "datei": "ton/hz-loesung-wegzug-1.mp3",
   "dauer": 2.46,
   "hash": "b1369775d0e2"
  },
  {
   "id": "hz-loesung-krimi-1",
   "gruppe": "hz_loesung_krimi",
   "text": "Eine Polizeiwache für mehr Sicherheit.",
   "datei": "ton/hz-loesung-krimi-1.mp3",
   "dauer": 2.06,
   "hash": "c3abfa25d5c9"
  },
  {
   "id": "hz-loesung-krank-1",
   "gruppe": "hz_loesung_krank",
   "text": "Ein Arzt für die Nachbarschaft. Gute Besserung!",
   "datei": "ton/hz-loesung-krank-1.mp3",
   "dauer": 2.59,
   "hash": "b2df4b118edc"
  },
  {
   "id": "hz-loesung-1",
   "gruppe": "hz_loesung",
   "text": "So, repariert. Ich bin eben ein Profi.",
   "datei": "ton/hz-loesung-1.mp3",
   "dauer": 2.56,
   "hash": "7a3845f9d5aa"
  },
  {
   "id": "hz-loesung-nicht-1",
   "gruppe": "hz_loesung_nicht",
   "text": "Hm, da passt nichts hin. Darum kümmere ich mich später.",
   "datei": "ton/hz-loesung-nicht-1.mp3",
   "dauer": 2.77,
   "hash": "94f9bde1fd67"
  },
  {
   "id": "hz-loesung-nicht-2",
   "gruppe": "hz_loesung_nicht",
   "text": "Okay, das kann ich gerade nicht reparieren. Weiter geht's!",
   "datei": "ton/hz-loesung-nicht-2.mp3",
   "dauer": 3.06,
   "hash": "1a87a3265897"
  },
  {
   "id": "kz-wechsel-1",
   "gruppe": "kz_wechsel",
   "text": "Mit dem Tier lief's nicht. Ich probiere ein anderes!",
   "datei": "ton/kz-wechsel-1.mp3",
   "dauer": 2.61,
   "hash": "df647d90fd94"
  },
  {
   "id": "kz-wechsel-2",
   "gruppe": "kz_wechsel",
   "text": "Neue Runde, neues Tier. Diesmal klappt's!",
   "datei": "ton/kz-wechsel-2.mp3",
   "dauer": 2.74,
   "hash": "0be1c722afea"
  },
  {
   "id": "kz-wechsel-3",
   "gruppe": "kz_wechsel",
   "text": "Ich hab nachgedacht: Ein anderes Tier muss her.",
   "datei": "ton/kz-wechsel-3.mp3",
   "dauer": 2.4,
   "hash": "27e4306d8d61"
  },
  {
