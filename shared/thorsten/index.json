   "dauer": 2.64,
   "hash": "01f8a967331b"
  },
  {
   "id": "runde-1",
   "gruppe": "runde",
   "text": "Nächste Runde! Jetzt aber richtig.",
   "datei": "ton/runde-1.mp3",
   "dauer": 1.91,
   "hash": "5cc46341d977"
  },
  {
   "id": "runde-2",
   "gruppe": "runde",
   "text": "Weiter geht's, Runde zwei!",
   "datei": "ton/runde-2.mp3",
   "dauer": 1.78,
   "hash": "1e8ea2ae525e"
  },
  {
   "id": "entscheidung-1",
   "gruppe": "entscheidung",
   "text": "Entscheidungsrunde! Jetzt zählt jeder Treffer!",
   "datei": "ton/entscheidung-1.mp3",
   "dauer": 2.43,
   "hash": "fcfc25deef50"
  },
  {
   "id": "sieg-1",
   "gruppe": "sieg",
   "text": "Ja! Gewonnen! Was für eine Runde!",
   "datei": "ton/sieg-1.mp3",
   "dauer": 2.32,
   "hash": "f9af260dfb44"
  },
  {
   "id": "sieg-2",
   "gruppe": "sieg",
   "text": "Sieg! Ich wusste es. Okay, ich hab's gehofft.",
