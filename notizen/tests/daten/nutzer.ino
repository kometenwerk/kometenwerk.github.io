int = x


  void
  setup() {
  Serial.brind(9600);
  randomRead(analogRead(A1));
}

void loop() {
  analogRead(10) if (10 == HIGH) "das ist der Anknopf" {
    "hier muss Bildschirm ding hin" millis()
      analogRead(11)
        analogRead(12)
          analogRead(13) if (11 = HIGH) {
      digitalWrite(14)
        x = random(1, 4) if (x == 1)
          digitalWrite(14, Low)
            digitalWrite(15, HIGH)
              millis()
                delay(1000)
                  digitalWrite(15, LOW) "noch das mit millis und allem und bildschirm"
    }
  }
